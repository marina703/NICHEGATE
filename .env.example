PORT=5000
# Bind to localhost by default (safer — the server can publish with real API keys).
# Set to 0.0.0.0 only if you need access from other devices on your network.
BIND_HOST=127.0.0.1
NODE_ENV=development

# ── Marketplaces ──
# Etsy: https://www.etsy.com/developers/register
ETSY_CLIENT_ID=your_etsy_client_id
ETSY_CLIENT_SECRET=your_etsy_client_secret
# Optional: cache the shop id after first OAuth connect
# ETSY_SHOP_ID=

# Gumroad: https://gumroad.com/settings/advanced → Application Secrets
GUMROAD_ACCESS_TOKEN=your_gumroad_token

# ── Notifications (optional) ──
# Discord webhook for instant alerts (review day, trends, publish errors)
DISCORD_WEBHOOK_URL=
# Optional email address for notifications
NOTIFY_EMAIL=
# ── AI idea layer (optional) ──
# Master switch. Off = every model call returns instantly at zero cost.
MODEL_ENABLED=false
# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Models per job (OpenRouter slugs): cheap scan, cheap judge, stronger ideation
# Defaults are budget-pinned: flash for scan, haiku for judge, deepseek for ideas.
# Override only if you need frontier for architecture decisions.
OPENROUTER_MODEL=google/gemini-flash-1.5
JUDGE_MODEL=anthropic/claude-3.5-haiku
IDEATION_MODEL=deepseek/deepseek-chat
# Cost guards
MODEL_MAX_CALLS_PER_SCAN=3
MODEL_MAX_CALLS_PER_IDEA_BATCH=4
MODEL_TIMEOUT_MS=25000
MODEL_MAX_TOKENS=1024
# Set to 1 to let `npm test` make real API calls (default: off)
RUN_MODEL_TESTS=0
// ── AI image layer (optional, free tier) ──
// Pollinations.ai: $0, no key. fal.ai FLUX: ~$0.003/img, needs FAL_API_KEY.
// Covers are photo-only backgrounds (no AI text — it garbles). Title card
// composites in the storefront/review UI via CSS overlay.
COVER_ART_PROVIDER=pollinations
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
# Get a key at https://fal.ai (only needed when COVER_ART_PROVIDER=fal)
FAL_API_KEY=
FAL_MODEL=fal-ai/flux/schnell
# Set to 1 to let `npm test` hit the real image endpoint (default: off)
RUN_COVER_TESTS=0
