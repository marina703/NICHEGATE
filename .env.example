PORT=5000
# Bind to localhost by default (safer — the server can publish with real API keys).
# Set to 0.0.0.0 only if you need access from other devices on your network.
BIND_HOST=127.0.0.1
NODE_ENV=development
# Admin dashboard password. Optional for local development; required in
# production (at least 16 characters) or the server refuses to start.
# The dashboard + admin APIs require a one-time sign-in (session cookie).
ADMIN_PASSWORD=
# Expose the launch-readiness report (POSTURE only, no secrets) without login.
# Leave blank to require admin auth. Set true only for external uptime monitors.
READYNESS_PUBLIC=false
# Production safety opt-ins: leave unset to keep startup automation and
# automatic marketplace publishing disabled. Enable independently only after
# reviewing Railway auth, volume persistence, marketplace credentials, and caps.
# AUTO_START_ENABLED=false
# AUTO_PUBLISH_ENABLED=false
# DB_PATH=                         # optional local/custom path; on Railway must stay inside the mounted volume


# ── Marketplaces ──
# Etsy: https://www.etsy.com/developers/register
ETSY_CLIENT_ID=your_etsy_client_id
ETSY_CLIENT_SECRET=your_etsy_client_secret
# Optional: cache the shop id after first OAuth connect
# ETSY_SHOP_ID=

# Gumroad: https://gumroad.com/settings/advanced → Application Secrets
GUMROAD_ACCESS_TOKEN=your_gumroad_token

# ── Notifications ──
# Discord webhook for alerts and surrogate questions; required in production
# and must be a valid HTTPS Discord webhook URL.
DISCORD_WEBHOOK_URL=
# Optional email address for notifications
NOTIFY_EMAIL=
# ── AI idea layer (optional) ──
# Master switch. Off = every model call returns instantly at zero cost.
MODEL_ENABLED=false
# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Models per job (OpenRouter slugs): cheap scan, cheap judge, stronger ideation
# Defaults are budget-pinned: flash for scan, haiku for judge, deepseek for ideas.
# Override only if you need frontier for architecture decisions.
OPENROUTER_MODEL=google/gemini-flash-1.5
JUDGE_MODEL=anthropic/claude-3.5-haiku
IDEATION_MODEL=deepseek/deepseek-chat
# Cost guards
MODEL_MAX_CALLS_PER_SCAN=3
MODEL_MAX_CALLS_PER_IDEA_BATCH=4
MODEL_TIMEOUT_MS=25000
MODEL_MAX_TOKENS=1024
# Set to 1 to let `npm test` make real API calls (default: off)
RUN_MODEL_TESTS=0
# ── AI image layer (optional, free tier) ──
# Pollinations.ai: $0, no key. fal.ai FLUX: ~$0.003/img, needs FAL_API_KEY.
# Covers are photo-only backgrounds (no AI text — it garbles). Title card
# composites in the storefront/review UI via CSS overlay.
COVER_ART_PROVIDER=cloudflare
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
# Cloudflare Workers AI (free 10k neurons/day): your deployed cover worker
COVER_WORKER_URL=https://nichegate-covers.marina-74d.workers.dev
# Optional shared secret if you set SHARED_KEY on the worker
COVER_WORKER_KEY=
# Etsy saturation + search signals use whichever Etsy key authenticates as
# x-api-key (ETSY_SHARED_SECRET, then ETSY_CLIENT_SECRET, then ETSY_CLIENT_ID)
# ETSY_SHARED_SECRET=
# The eBay public /trending scraper is disabled by default (403 from server
# egress); set true only if you have verified the endpoint is accessible.
EBAY_TRENDING_ENABLED=false
# Get a key at https://fal.ai (only needed when COVER_ART_PROVIDER=fal)
FAL_API_KEY=
FAL_MODEL=fal-ai/flux/schnell
# Set to 1 to let `npm test` hit the real image endpoint (default: off)
RUN_COVER_TESTS=0

# ── Marketing Bot (Phase 6+) ──
# Autonomous distribution: Pinterest, TikTok ads, Reddit/X, email sequences.
# Every channel is optional — without its token the bot generates
# ready-to-import creatives/content instead of failing. Set MARKETING_AUTO_ENABLED
# to let the 6-hour cycle run the marketing bot on its own (production gate).
MARKETING_AUTO_ENABLED=false
# Production marketing opt-in (matches AUTO_PUBLISH_ENABLED gating)
# TikTok Ads API v2 — https://ads.tiktok.com/marketing_api, OAuth2 app
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_DEFAULT_DAILY_BUDGET=20
TIKTOK_MAX_DAILY_BUDGET=100
TIKTOK_MAX_TOTAL_BUDGET=500
# Pinterest API v5 — https://developers.pinterest.com/apps/
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=general
# Buffer (interim Pinterest publisher while NicheGate app is trial-only)
BUFFER_API_TOKEN=
BUFFER_CHANNEL_ID=
BUFFER_BOARD_SERVICE_ID=
# Reddit API — https://www.reddit.com/prefs/apps (script app)
REDDIT_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X (Twitter) API — https://developer.x.com
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
# Email service provider: Kit (ConvertKit) V4 or MailerLite free tier.
# NicheGate NEVER sends email itself — it exports sequences to the ESP webhook.
ESP_WEBHOOK_URL=
# Buffer-style fallback if ESP webhook not set

